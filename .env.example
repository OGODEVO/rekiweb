# Copy to .env (never commit .env). All secrets stay server-side.
# Non-secret IDs/URLs are returned by the Whop agent and pasted here by the owner.

PORT=3001
NODE_ENV=development

# Public base URL of the deployed app. REQUIRED in production.
# Example: PUBLIC_BASE_URL=https://reki.example.com
# Return URL sent to the Whop agent:  {PUBLIC_BASE_URL}/api/whop/return
# Webhook URL sent to the Whop agent: {PUBLIC_BASE_URL}/api/webhooks/whop
PUBLIC_BASE_URL=

# Whop server credentials (secret — server env only, never GitHub).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Whop OAuth app (WHOP_APP_ID looks like app_...; not a secret but keep in env).
WHOP_APP_ID=
# Only if the Whop app is confidential; otherwise leave empty.
WHOP_CLIENT_SECRET=

# Whop business objects (not secrets; from the Whop agent's report).
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
WHOP_PLAN_ID=
WHOP_CHECKOUT_URL=

# Paid access window. Test offer: 30 days, no automatic renewal.
ACCESS_DURATION_DAYS=30

# Random 32+ byte string for session cookies (secret).
SESSION_SECRET=

# SQLite file. Use :memory: for tests.
DATABASE_PATH=./data/reki-web.sqlite

# Pinned Whop API version.
WHOP_API_BASE=https://api.whop.com
WHOP_API_VERSION_DATE=2026-09-15
