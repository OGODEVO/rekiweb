# Copy to .env (never commit .env). All secrets stay server-side.
# Non-secret IDs/URLs are returned by the Whop agent and pasted here by the owner.

HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Public base URL of the deployed app. REQUIRED in production.
# Production: PUBLIC_BASE_URL=https://web.rekisupplement.com
# Return URL registered with Whop:  {PUBLIC_BASE_URL}/api/whop/return
# Webhook URL registered with Whop: {PUBLIC_BASE_URL}/api/webhooks/whop
PUBLIC_BASE_URL=

# Whop server credentials (secret — server env only, never GitHub).
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Whop OAuth app (WHOP_APP_ID looks like app_...; not a secret but keep in env).
WHOP_APP_ID=
# The Whop app is confidential: client secret REQUIRED (dashboard straight into env).
WHOP_CLIENT_SECRET=

# Whop business objects (not secrets; from the Whop agent's report).
# Production values for the $15 membership (now + every 30 days):
#   WHOP_ACCOUNT_ID=<biz_... from Whop report>
#   WHOP_PRODUCT_ID=<prod_... from Whop report>
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=
# Must be the recurring plan. Production: plan_ntTuSfZpGhMJu
WHOP_PLAN_ID=plan_ntTuSfZpGhMJu
# Must be the matching checkout. Production: https://whop.com/checkout/ch_mMNbh5gIMIjL09n/
WHOP_CHECKOUT_URL=

# SQLite file. Use :memory: for tests.
DATABASE_PATH=./data/reki-web.sqlite

# Pinned Whop API version. Must stay 2026-09-15.
WHOP_API_BASE=https://api.whop.com
WHOP_API_VERSION_DATE=2026-09-15
